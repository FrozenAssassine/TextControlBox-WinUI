<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>TextControlBoxNS</RootNamespace>
		<!-- Enables the trimming and Native AOT analyzers, apps that publish with AOT can use the control -->
		<IsAotCompatible>true</IsAotCompatible>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile></DocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>TextControlBox.WinUI.JuliusKirsch</PackageId>
		<Title>TextControlBox WinUI</Title>
		<Version>1.7.0</Version>
		<Authors>Julius Kirsch</Authors>
		<Product>TextControlBox WinUI</Product>
		<Description>A powerful and highly customizable textbox control for WinUI 3 applications. It provides an advanced text editing experience with features like syntax highlighting for multiple programming languages, intuitive search and replace functionality, zooming, line numbering, and smooth scrolling. With support for undo/redo, customizable themes, and efficient performance.</Description>
		<Copyright>2024-2026 Julius Kirsch</Copyright>
		<PackageProjectUrl>https://github.com/FrozenAssassine/TextControlBox-WinUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/FrozenAssassine/TextControlBox-WinUI</RepositoryUrl>
		<PackageTags>TextControlBox; Textbox; WinUI; C#; SyntaxHighlighting; LineNumbers</PackageTags>
		<PackageReleaseNotes>
			New: Word wrap (WordWrap), also for very large documents and very long lines
			New: Touch and pen support (tap, double/triple tap, long press selection, pinch zoom)
			New: IME input (Japanese, Chinese, Korean) and full emoji support
			New: Smooth scrolling, wheel acceleration, diagonal touchpad scrolling, touchpad pinch zoom
			New: Batched undo (UndoBatching), Dispose(), Delete(), GetLineFromPoint(), ScrollIntoViewHorizontallyCentered()
			New: Native AOT compatible, log file and generic language independent syntax highlighting
			Improved: Much faster editing of long lines and lower undo memory usage
			Improved: Syntax highlighting accuracy and performance for all languages
			Changed: JSON languages load via System.Text.Json, Newtonsoft.Json dependency removed
			Changed: AddLines throws for lines containing line breaks
			Fixed: Many undo/redo, selection, cursor, word wrap, zoom and scrolling bugs
			Fixed: Memory leaks after closing tabs, theme changes, double right click menu
			Full changelog: https://github.com/FrozenAssassine/TextControlBox-WinUI/blob/master/CHANGELOG.md
		</PackageReleaseNotes>
		<PackageIcon>Icon1.png</PackageIcon>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TextControlBox-TestApp" />
    <None Remove="Core\CoreTextControlBox.xaml" />
  </ItemGroup>
	<ItemGroup>
		<None Include="..\images\Icon1.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

  <ItemGroup>
      <PackageReference Include="Collections.Pooled" Version="1.0.82" />
      <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
	  <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
	  <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Text\CoreTextControlBox.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
</Project>