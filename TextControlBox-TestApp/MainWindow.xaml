<Window
    x:Class="TextControlBox_TestApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextControlBox_TestApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:textcontrolbox="using:TextControlBoxNS"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="10,8,10,8">
            <ToggleButton x:Name="WordWrapToggle" Content="WordWrap: Aus" Click="WordWrapToggle_Click"/>
            <Button Content="Load 100k Line" Click="LoadLongLine_Click"/>
            <Button Content="Load Code Sample" Click="LoadCodeSample_Click"/>
            <Button Content="Center Scroll Cursor" Click="CenterScroll_Click"/>
            <Button Content="Zoom -" Click="ZoomOut_Click"/>
            <Button Content="Zoom +" Click="ZoomIn_Click"/>
            <Button Content="Reset Zoom" Click="ZoomReset_Click"/>
            <Button Content="Diagnose Coordinates" Click="DiagnosePositions_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Text="Bereit"/>
        </StackPanel>

        <textcontrolbox:TextControlBox Grid.Row="1" x:Name="textbox"/>
    </Grid>
</Window>
